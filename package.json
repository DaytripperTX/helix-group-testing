    "react-dom": "^18.3.1",
    "read-excel-file": "^9.2.0"
  },
  "devDependencies": {
    "@netlify/database-dev": "0.10.1",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
