# Copy this file to .env.local for local development.
# Set the real production/beta values in the Netlify site environment variable UI.

HELIX_ALLOW_LOCAL_DEFAULTS=false
HELIX_DATA_ADAPTER=local
HELIX_ADMIN_PASSWORD=
HELIX_OWNER_PASSWORD=
HELIX_ADMIN_SESSION_SECRET=

# Optional runtime threshold for deriving Pass/Fail from quantitative endotoxin results.
# Results strictly below this EU/mL value pass. Defaults to 5 when unset.
# HELIX_ENDOTOXIN_PASS_THRESHOLD_EU_ML=5

# Optional build-time page toggle. Changes require rebuilding/redeploying.
# Allowed values: order-form, testing, coas, labels, faqs
# Example: DISABLED_PAGES=order-form,coas
DISABLED_PAGES=

# Optional fallback for Netlify Blobs API access if Lambda context is unavailable.
# NETLIFY_SITE_ID=
# NETLIFY_BLOBS_TOKEN=
